# Server
NODE_ENV=development
PORT=3010

# Optional. Defaults to webhook. Set per branch if both run on the same host.
PM2_APP_NAME=webhook

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=bluedart_db

# Blue Dart credentials (sent by Blue Dart in request headers)
BLUEDART_CLIENT_ID=your-client-id
BLUEDART_LICENSE_KEY=your-license-key

# Set to true in production to allow only Blue Dart IPs
BLUEDART_ENABLE_IP_WHITELIST=false
